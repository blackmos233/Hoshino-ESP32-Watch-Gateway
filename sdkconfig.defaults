# ============================================================
# Vela/Hoshino WROOM low-memory configuration (ESP-IDF 4.4.x)
# Target: uPesy ESP32 WROOM DevKit, 4MB Flash, no PSRAM
# Classic BT SPP + Wi-Fi STA + lwIP/NAPT simultaneously.
# ============================================================

# ---------- Bluetooth: Classic BR/EDR only ----------
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_SMP_MAX_BONDS=1

# ---------- Wi-Fi: minimum-memory profile ----------
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_RX_BA_WIN=3
CONFIG_ESP32_WIFI_TX_BA_WIN=3
CONFIG_ESP32_WIFI_MGMT_SBUF_NUM=8

# ---------- lwIP routing/NAPT ----------
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_ACTIVE_TCP=4
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_MAX_RAW_PCBS=4

# ---------- task/runtime ----------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ARDUINO_LOOP_TASK_STACK_SIZE=4096
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_FREERTOS_HZ=1000

# uPesy WROOM board is 4MB. Do NOT copy the upstream project's 2MB setting:
# this fork's OLED/U8g2 build is already ~2.0MB and uses huge_app.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
