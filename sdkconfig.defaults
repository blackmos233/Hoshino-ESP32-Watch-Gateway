# ============================================================
# WROOM 低内存配置：Classic BT (BR/EDR Only) + WiFi Minimum 档
# 目标：让 ESP32-WROOM 同时跑蓝牙 SPP + WiFi STA + 网络桥
# ============================================================

# ---------- 蓝牙：只保留 Classic BR/EDR，彻底不要 BLE ----------
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
# 只有一个 ACL 连接（ESP32 <-> 手表），省 ~1.2KB DRAM
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_ACL_CONNECTIONS=1
# 只绑定一个手表
CONFIG_BT_SMP_MAX_BONDS=1

# ---------- WiFi：Minimum 内存档（不需要高吞吐） ----------
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_RX_BA_WIN=3
CONFIG_ESP32_WIFI_TX_BA_WIN=3
CONFIG_ESP32_WIFI_MGMT_SBUF_NUM=8

# ---------- lwIP：启用 IP 转发 + NAPT ----------
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y

# ---------- lwIP：缩小 TCP 缓冲 ----------
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_ACTIVE_TCP=4
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_MAX_RAW_PCBS=4

# ---------- 任务栈 ----------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ARDUINO_LOOP_TASK_STACK_SIZE=4096
CONFIG_AUTOSTART_ARDUINO=y

# ---------- mbedTLS：启用 PSK（WiFiClientSecure 需要） ----------
CONFIG_MBEDTLS_PSK_MODES=y

# ---------- Flash：2MB（板子实际容量） ----------
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y

# Arduino 组件硬性要求
CONFIG_FREERTOS_HZ=1000
